{
  "name": "rendezvous",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "dev:backend": "node --env-file=.env --import tsx scripts/dev-backend.ts",
    "dev:web": "npm --prefix frontend run dev",
    "mcp": "tsx scripts/mcp-server.ts",
    "rendezvous": "node --import tsx src/cli/main.ts",
    "build:web": "npm --prefix frontend run build",
    "start:web": "npm --prefix frontend run start",
    "build": "node scripts/build.js",
    "test": "npm run build && tsx --test --test-concurrency=1 test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc -p tsconfig.tests.json",
    "demo": "tsx scripts/demo.ts",
    "test:postgres": "npm run build && node scripts/test-postgres.js",
    "test:ui": "npm run build && npm run build:web && tsx --test --test-concurrency=1 e2e/*.test.ts",
    "demo:tmux": "npm run build && node scripts/tmux-demo.js",
    "build:cli": "node scripts/build-cli.js",
    "pack:cli": "npm run build:cli && npm pack ./packages/cli",
    "test:cli": "npm run build && node --import tsx --test --test-concurrency=1 test/cli*.test.ts",
    "data:up": "docker compose -f compose.data.yaml up -d --wait",
    "data:down": "docker compose -f compose.data.yaml down",
    "data:status": "docker compose -f compose.data.yaml ps"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@workos-inc/node": "^10.13.0",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "jsonc-parser": "^3.3.1",
    "pg": "^8.23.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/proper-lockfile": "^4.1.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
