{
  "name": "agent-rendezvous",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "dev:backend": "node --import tsx scripts/dev-backend.ts",
    "dev:web": "npm --prefix frontend run dev",
    "dev:proxy": "tsx scripts/dev-proxy.ts",
    "build:web": "npm --prefix frontend run build",
    "start:web": "npm --prefix frontend run start",
    "build": "node scripts/build.js",
    "test": "npm run build && tsx --test --test-concurrency=1 test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "typecheck": "tsc -p tsconfig.tests.json",
    "demo": "tsx scripts/demo.ts",
    "test:postgres": "npm run build && node scripts/test-postgres.js",
    "test:ui": "npm run build && npm run build:web && tsx --test e2e/ui.test.ts",
    "demo:tmux": "npm run build && node scripts/tmux-demo.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "express": "^5.2.1",
    "jsonc-parser": "^3.3.1",
    "pg": "^8.23.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/proper-lockfile": "^4.1.4",
    "embedded-postgres": "^18.4.0-beta.17",
    "http-proxy-middleware": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
