{$DOMAIN} {
    # Access logging is intentionally disabled; do not add credential-bearing URLs.
    @relay path /api /api/* /join /join/* /protocol /protocol/* /.well-known/* /health /style.css
    handle @relay {
        reverse_proxy app:3000 {
            transport http {
                response_header_timeout 75s
            }
        }
    }
    handle {
        reverse_proxy frontend:3001
    }
}
