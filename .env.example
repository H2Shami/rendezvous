HOST=127.0.0.1
PORT=4372
# Public frontend origin (also used in invitations and instructions).
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
EXPRESS_URL=http://127.0.0.1:4372
# Optional: set this to the HTTPS URL ngrok gives you and run `ngrok http 3000`.
# It overrides PUBLIC_URL and FRONTEND_URL when set.
# NGROK_DOMAIN=https://your-id.ngrok.app
DATA_DIR=.data
# Managed deployments can supply a stable pepper from a secret store instead of disk.
# TOKEN_PEPPER=at-least-32-random-bytes-keep-stable-for-the-life-of-the-database
# Omit DATABASE_URL to use persistent embedded PostgreSQL (PGlite).
# DATABASE_URL=postgresql://rendezvous:password@localhost:5432/rendezvous
SESSION_TTL_SECONDS=86400
MAX_TTL_SECONDS=604800
RETENTION_SECONDS=86400
MESSAGE_BUDGET=10000
MESSAGES_PER_MINUTE=60
SESSIONS_PER_HOUR=10
JOINS_PER_HOUR=30
# Only set behind a controlled proxy; use its address/subnet, never arbitrary true.
# TRUST_PROXY=loopback

# Local Docker stores: set a password, then npm run data:up.
# POSTGRES_PASSWORD=replace-with-a-random-password
# POSTGRES_PORT=55432
# DATABASE_URL=postgresql://rendezvous:URL_ENCODED_PASSWORD@127.0.0.1:55432/rendezvous

# Owner accounts: Cognito public app client, authorization-code + PKCE (no client secret).
# Shared development pool; these identifiers are public, not secrets.
# Register/sign in through http://localhost:3000/account; no AWS console access needed.
# Omit all three to disable sign-in. Production supplies its own pool/client.
OWNER_OIDC_ISSUER=https://cognito-idp.us-east-2.amazonaws.com/us-east-2_5EYdg33zR
OWNER_OIDC_CLIENT_ID=nig2tofm7fv8phbf7m1ebq2lg
OWNER_OIDC_LOGOUT_URL=https://rendezvous-local-693067573106.auth.us-east-2.amazoncognito.com/logout

# Google is already connected to the shared development Cognito pool.
OWNER_GOOGLE_ENABLED=true
# Google secrets are only needed by maintainers running scripts/auth/configure-dev.ts.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GitHub OAuth credentials are backend-only; never prefix with NEXT_PUBLIC_.
# Callback: http://localhost:3000/api/v1/owner/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
