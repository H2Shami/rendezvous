HOST=127.0.0.1
PORT=4372
# Public frontend origin (also used in invitations and instructions).
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
EXPRESS_URL=http://127.0.0.1:4372
# Optional: set this to the HTTPS URL ngrok gives you and run `ngrok http 3000`.
# It overrides PUBLIC_URL and FRONTEND_URL when set.
# NGROK_DOMAIN=https://your-id.ngrok.app
DATA_DIR=.data
# Managed deployments can supply a stable pepper from a secret store instead of disk.
# TOKEN_PEPPER=at-least-32-random-bytes-keep-stable-for-the-life-of-the-database
# Omit DATABASE_URL to use persistent embedded PostgreSQL (PGlite).
# DATABASE_URL=postgresql://rendezvous:password@localhost:5432/rendezvous
SESSION_TTL_SECONDS=86400
MAX_TTL_SECONDS=604800
RETENTION_SECONDS=86400
MESSAGE_BUDGET=10000
MESSAGES_PER_MINUTE=60
SESSIONS_PER_HOUR=10
JOINS_PER_HOUR=30
# Only set behind a controlled proxy; use its address/subnet, never arbitrary true.
# TRUST_PROXY=loopback

# Local Docker stores: set a password, then npm run data:up.
# POSTGRES_PASSWORD=replace-with-a-random-password
# POSTGRES_PORT=55432
# DATABASE_URL=postgresql://rendezvous:URL_ENCODED_PASSWORD@127.0.0.1:55432/rendezvous

# Owner accounts: Cognito public app client, authorization-code + PKCE (no client secret).
# Set all three to enable; omit all three to keep existing rooms available without sign-in.
# Register PUBLIC_URL/api/v1/owner/callback and PUBLIC_URL/account in Cognito.
# OWNER_OIDC_ISSUER=https://cognito-idp.us-east-2.amazonaws.com/us-east-2_POOL
# OWNER_OIDC_CLIENT_ID=your-cognito-app-client-id
# OWNER_OIDC_LOGOUT_URL=https://your-prefix.auth.us-east-2.amazoncognito.com/logout
