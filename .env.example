HOST=127.0.0.1
PORT=3000
# Public routing-proxy origin, not the internal Express listening address.
PUBLIC_URL=http://127.0.0.1:8080
DATA_DIR=.data
# Omit DATABASE_URL to use persistent embedded PostgreSQL (PGlite).
# DATABASE_URL=postgresql://rendezvous:password@localhost:5432/rendezvous
SESSION_TTL_SECONDS=86400
MAX_TTL_SECONDS=604800
RETENTION_SECONDS=86400
MESSAGE_BUDGET=10000
MESSAGES_PER_MINUTE=60
SESSIONS_PER_HOUR=10
JOINS_PER_HOUR=30
# Only set behind a controlled proxy; use its address/subnet, never arbitrary true.
# TRUST_PROXY=loopback
# Local routing process (npm run dev:proxy); Next runs on 3001.
# PROXY_PORT=8080
# API_TARGET=http://127.0.0.1:3000
# FRONTEND_TARGET=http://127.0.0.1:3001
