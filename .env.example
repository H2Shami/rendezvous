HOST=127.0.0.1
PORT=4372
# Public frontend origin (also used in invitations and instructions).
PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
EXPRESS_URL=http://127.0.0.1:4372
# Optional: set this to the HTTPS URL ngrok gives you and run `ngrok http 3000`.
# It overrides PUBLIC_URL and FRONTEND_URL when set.
# NGROK_DOMAIN=https://your-id.ngrok.app
# Public starter credentials for LOCAL DEVELOPMENT ONLY. Never use for hosted dev/prod.
# Hosted deployments must inject private generated secrets (Pulumi does this).
TOKEN_PEPPER=rendezvous-local-only-pepper-do-not-use-in-hosted-environments
DATABASE_URL=postgresql://rendezvous:rendezvous_local_only@127.0.0.1:55432/rendezvous
# DATA_DIR is deprecated for application runs; PostgreSQL holds all database data.
SESSION_TTL_SECONDS=86400
MAX_TTL_SECONDS=604800
RETENTION_SECONDS=86400
MESSAGE_BUDGET=10000
MESSAGES_PER_MINUTE=60
SESSIONS_PER_HOUR=10
JOINS_PER_HOUR=30
# Only set behind a controlled proxy; use its address/subnet, never arbitrary true.
# TRUST_PROXY=loopback

# Local Docker PostgreSQL: matches DATABASE_URL above. Run npm run data:up.
POSTGRES_PASSWORD=rendezvous_local_only
# POSTGRES_PORT=55432

# Owner accounts: WorkOS AuthKit handles email, Google, GitHub, verification and recovery.
# Use one WorkOS staging environment for local and hosted dev; production is separate.
# Keep the API key backend-only. Get staging credentials from the project maintainer.
# Set both to enable sign-in; neither means room-only mode. Partial config fails startup.
# WORKOS_API_KEY=sk_test_replace_me
# WORKOS_CLIENT_ID=client_replace_me
# WorkOS application redirect URIs:
# http://localhost:3000/api/v1/owner/callback
# https://dev.userendezvous.com/api/v1/owner/callback
# Register matching /account logout destinations in WorkOS as well.
